# ---- Route ----------------------------------------------------------------
# NYC is a metro code and covers JFK + LGA + EWR in a single query.
FW_ORIGIN=NYC
FW_DESTINATION=SJU
FW_STAY_NIGHTS=4

# How far ahead to look, in days from today.
FW_WINDOW_START_DAYS=21
FW_WINDOW_END_DAYS=180

# ---- Scanning -------------------------------------------------------------
# Price backend. Only google-flights is implemented; serpapi is a stub.
FW_SOURCE=google-flights
# Seconds to sleep between requests (randomised +/-50%) to stay polite.
FW_REQUEST_DELAY=2.5
FW_MAX_RETRIES=3

# ---- Alerting -------------------------------------------------------------
# Fire when the best trip is at or below this percentile of recent history.
FW_ALERT_PERCENTILE=20
FW_BASELINE_DAYS=30
# Never alert above this price, even if it is a statistical low. Blank = no cap.
FW_PRICE_CEILING=
# Suppress repeat alerts for this many hours unless the price drops further.
FW_COOLDOWN_HOURS=20
FW_REARM_DROP_PCT=10
# Refuse to alert until history is this deep -- avoids day-one false positives.
FW_WARMUP_OBSERVATIONS=300
FW_WARMUP_DAYS=3

# ---- Notifications --------------------------------------------------------
# ntfy.sh: pick an unguessable topic, subscribe to it in the ntfy phone app.
FW_NTFY_TOPIC=
FW_NTFY_SERVER=https://ntfy.sh

# Optional email fallback (Gmail app password, 2FA required).
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
ALERT_TO_EMAIL=

# ---- Paths ----------------------------------------------------------------
# Defaults to ~/.flight_watch/ if unset.
FW_DB_FILE=
FW_LOG_FILE=
FW_LOG_LEVEL=INFO
